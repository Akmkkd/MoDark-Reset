<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glow" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕷️"
                    android:textSize="40sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MO.DARK"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#00F0FF"
                        android:letterSpacing="0.15"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GUEST RESET ENGINE v7.0"
                        android:textSize="11sp"
                        android:textColor="#00F0FF"
                        android:alpha="0.6"
                        android:letterSpacing="0.2"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_indicator"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/rootStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROOT ✓"
                    android:textSize="12sp"
                    android:textColor="#00FF88"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/badge_root"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/headerLayout"
                app:cardBackgroundColor="#141C2B"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="حالة النظام"
                            android:textSize="14sp"
                            android:textColor="#E8EDF5"
                            android:alpha="0.7"
                            android:fontFamily="sans-serif" />

                        <View
                            android:layout_width="60dp"
                            android:layout_height="3dp"
                            android:background="@drawable/gradient_line"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/systemStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● جاهز"
                            android:textSize="14sp"
                            android:textColor="#00FF88"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#2A3A5A"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📱"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="التطبيق"
                                android:textSize="11sp"
                                android:textColor="#E8EDF5"
                                android:alpha="0.5"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/appStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="غير معروف"
                                android:textSize="13sp"
                                android:textColor="#00F0FF"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔒"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="الجدار الناري"
                                android:textSize="11sp"
                                android:textColor="#E8EDF5"
                                android:alpha="0.5"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/firewallStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="نشط"
                                android:textSize="13sp"
                                android:textColor="#00FF88"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🆔"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="الهوية"
                                android:textSize="11sp"
                                android:textColor="#E8EDF5"
                                android:alpha="0.5"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/identityStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="جديدة"
                                android:textSize="13sp"
                                android:textColor="#FFAA00"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/buttonsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/statusCard"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#00F0FF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="12dp"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/resetButton"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/button_primary"
                        android:text="🚀  تنفيذ الإعادة الكاملة"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0A0E17"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.05"
                        android:stateListAnimator="@null" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FF0055"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/killButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/button_secondary"
                        android:text="⛔  قتل التطبيق فقط"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFAA00"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <Button
                        android:id="@+id/blockButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/button_tertiary"
                        android:text="🌐  حظر الخادم فقط"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0A0E17"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/logCard"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_below="@id/buttonsLayout"
                app:cardBackgroundColor="#0A0E17"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/logHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📋  سجل العمليات"
                            android:textSize="13sp"
                            android:textColor="#E8EDF5"
                            android:alpha="0.7"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/logCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="11sp"
                            android:textColor="#00F0FF"
                            android:background="@drawable/badge_count"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_marginEnd="8dp" />

                        <ImageView
                            android:id="@+id/clearLogButton"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_clear"
                            android:tint="#FF0055"
                            android:alpha="0.6" />
                    </LinearLayout>

                    <View
                        android:id="@+id/logDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#2A3A5A"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_below="@id/logHeader" />

                    <ScrollView
                        android:id="@+id/logScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@id/logDivider"
                        android:scrollbars="vertical"
                        android:paddingTop="4dp">

                        <TextView
                            android:id="@+id/logText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="[●] النظام جاهز\n[●] انتظار التنفيذ..."
                            android:textSize="12sp"
                            android:textColor="#00F0FF"
                            android:alpha="0.8"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="3dp" />
                    </ScrollView>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/logCard"
                android:text="⚡ Mo.dark Engineering v7.0  |  UESM ALPHA"
                android:textSize="10sp"
                android:textColor="#E8EDF5"
                android:alpha="0.3"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.1" />

        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
